{
  "name": "aseprite-io",
  "version": "0.1.0",
  "description": "Read and write Aseprite .ase/.aseprite files in TypeScript. Works in browsers and Node.js.",
  "keywords": [
    "aseprite",
    "ase",
    "sprite",
    "pixel-art",
    "gamedev",
    "tilemap",
    "parser",
    "browser"
  ],
  "homepage": "https://jensenchappell.com/aseprite-io/",
  "bugs": {
    "url": "https://github.com/aljopro/aseprite-io/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aljopro/aseprite-io.git"
  },
  "license": "MIT",
  "author": "Jensen Chappell",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.demo.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:browser": "node scripts/check-browser-bundle.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:browser",
    "test:coverage": "vitest run --coverage",
    "build:demo": "node scripts/build-demo.mjs",
    "docs": "typedoc",
    "site": "npm run build:demo && npm run docs",
    "dev:demo": "node scripts/build-demo.mjs --serve",
    "bench": "npm run build --silent && node bench/run.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pako": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "tinybench": "^6.2.4",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
